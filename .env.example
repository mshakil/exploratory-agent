# Required for UI and CLI
DATABASE_URL=postgres://ae:ae@127.0.0.1:5432/agent_explorer

# Artifact root for session memory + application-context (default ./data)
AE_DATA_DIR=./data

# HMAC secret for login cookies (required in production; >= 16 chars)
AE_SESSION_SECRET=change-me-to-a-long-random-string

# Optional: bind Secure cookie / CORS / Azure AD
# AE_COOKIE_SECURE=1
# AE_CORS_ORIGIN=http://192.168.1.10:3847
# AE_PUBLIC_BASE_URL=http://192.168.1.10:3847
# AZURE_AD_TENANT_ID=
# AZURE_AD_CLIENT_ID=
# AZURE_AD_CLIENT_SECRET=

# Optional: CLI explore owner (defaults to auto-created "cli" user)
# AE_CLI_USER_ID=
